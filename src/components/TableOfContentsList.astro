---
interface TocItem {
	depth: number;
	slug: string;
	text: string;
	children: TocItem[];
}

interface Props {
	items: TocItem[];
	nested?: boolean;
}

const { items, nested = false } = Astro.props as Props;
---

<ul
	class:list={[
		nested
			? 'mt-0.5 space-y-0.5 border-l border-zinc-200 pl-2 dark:border-zinc-700'
			: 'space-y-0.5',
	]}
>
	{
		items.map((item) => (
			<li>
				<a
					href={`#${item.slug}`}
					data-toc-link
					data-toc-slug={item.slug}
					class="block truncate py-0.5 text-xs text-zinc-500 no-underline transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
				>
					{item.text}
				</a>
				{item.children.length > 0 && <Astro.self items={item.children} nested />}
			</li>
		))
	}
</ul>

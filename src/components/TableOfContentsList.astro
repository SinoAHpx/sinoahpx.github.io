---
interface TocItem {
	depth: number;
	slug: string;
	text: string;
	children: TocItem[];
}

interface Props {
	items: TocItem[];
	nested?: boolean;
}

const { items, nested = false } = Astro.props as Props;
---

<ul
	class:list={[
		nested
			? 'mt-0.5 space-y-0.5 border-l border-ink-faint/20 pl-2 dark:border-ink-faint-dark/30'
			: 'space-y-0.5',
	]}
>
	{
		items.map((item) => (
			<li>
				<a
					href={`#${item.slug}`}
					data-toc-link
					data-toc-slug={item.slug}
					class="block truncate py-0.5 font-sans text-xs text-ink-light no-underline transition-colors hover:text-ink dark:text-ink-light-dark dark:hover:text-ink-dark"
				>
					{item.text}
				</a>
				{item.children.length > 0 && <Astro.self items={item.children} nested />}
			</li>
		))
	}
</ul>

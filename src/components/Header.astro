---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="mt-12 mb-6 py-24 md:mt-6 md:mb-3">
	<div class="text-center">
		<h1 class="m-0 text-[2.2rem] tracking-[0.08em] uppercase">
			<a href="/" class="text-[rgb(var(--black))] no-underline">{SITE_TITLE}</a>
		</h1>
		<nav
			class="mt-3 inline-flex items-center justify-center gap-5 text-[0.9rem] uppercase tracking-[0.12em]"
		>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
	</div>
</header>

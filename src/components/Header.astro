---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="pt-24 pb-16">
	<button
		id="theme-toggle"
		type="button"
		class="fixed right-4 top-4 z-50 inline-flex h-10 w-10 items-center justify-center text-ink-faint transition hover:text-ink dark:text-ink-faint-dark dark:hover:text-ink-dark"
		aria-label="Toggle theme"
		title="Toggle theme"
	>
		<span class="sr-only">Toggle theme</span>
		<svg
			class="h-5 w-5 dark:hidden"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
		</svg>
		<svg
			class="hidden h-5 w-5 dark:inline"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2" />
			<path d="M12 20v2" />
			<path d="M4.93 4.93l1.41 1.41" />
			<path d="M17.66 17.66l1.41 1.41" />
			<path d="M2 12h2" />
			<path d="M20 12h2" />
			<path d="M4.93 19.07l1.41-1.41" />
			<path d="M17.66 6.34l1.41-1.41" />
		</svg>
	</button>
	<div class="mx-auto flex max-w-2xl flex-col items-center px-4 text-center">
		<a
			href="/"
			class="text-5xl tracking-[0.3em] text-ink no-underline dark:text-ink-dark"
		>
			{SITE_TITLE}
		</a>
		<div class="mt-6 flex justify-center">
			<span class="block h-px w-10 bg-ink-faint/40 dark:bg-ink-faint-dark/60" />
		</div>
		<nav class="mt-8 flex items-center gap-8 text-xs text-ink-faint tracking-wide dark:text-ink-faint-dark">
			<HeaderLink href="/">文章</HeaderLink>
			<HeaderLink href="/archive">归档</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</nav>
	</div>
</header>

<script is:inline>
	(() => {
		const storageKey = 'theme';
		const root = document.documentElement;
		const button = document.getElementById('theme-toggle');

		if (!(button instanceof HTMLButtonElement)) return;

		const getStoredTheme = () => {
			try {
				return localStorage.getItem(storageKey);
			} catch {
				return null;
			}
		};

		const setStoredTheme = (theme) => {
			try {
				localStorage.setItem(storageKey, theme);
			} catch {}
		};

		const applyTheme = (theme, { persist } = { persist: false }) => {
			const isDark = theme === 'dark';
			root.classList.toggle('dark', isDark);
			root.style.colorScheme = isDark ? 'dark' : 'light';
			button.setAttribute('aria-pressed', String(isDark));

			if (persist) setStoredTheme(theme);
			window.dispatchEvent(
				new CustomEvent('theme-change', { detail: { theme } }),
			);
		};

		const initialIsDark = root.classList.contains('dark');
		button.setAttribute('aria-pressed', String(initialIsDark));

		button.addEventListener('click', () => {
			const isDark = root.classList.contains('dark');
			applyTheme(isDark ? 'light' : 'dark', { persist: true });
		});

		const mql = window.matchMedia?.('(prefers-color-scheme: dark)');
		mql?.addEventListener?.('change', (event) => {
			if (getStoredTheme() !== null) return;
			applyTheme(event.matches ? 'dark' : 'light');
		});
	})();
</script>

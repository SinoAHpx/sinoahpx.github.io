---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="py-16">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 text-center">
    <a
      href="/"
      class="text-3xl font-semibold uppercase tracking-[0.18em] text-zinc-900 no-underline"
    >
      {SITE_TITLE}
    </a>
    <p class="mt-3 max-w-2xl text-sm text-zinc-500">
      Building, shipping, iterating.
    </p>
    <nav
      class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs font-medium uppercase tracking-[0.2em] text-zinc-500"
    >
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/archive">Archive</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </nav>
  </div>
</header>

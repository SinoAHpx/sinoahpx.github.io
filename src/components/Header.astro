---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="border-b border-zinc-200">
	<div
		class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4"
	>
		<a
			href="/"
			class="text-sm font-semibold tracking-tight text-zinc-900 no-underline"
		>
			{SITE_TITLE}
		</a>
		<nav
			class="flex items-center gap-4 text-xs font-medium uppercase tracking-[0.2em] text-zinc-500"
		>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
	</div>
</header>

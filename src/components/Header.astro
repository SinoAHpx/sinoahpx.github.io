---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="pt-16 pb-6">
	<button
		id="theme-toggle"
		type="button"
		class="fixed right-4 top-4 z-50 inline-flex h-10 w-10 items-center justify-center border border-zinc-300 bg-white text-zinc-600 transition hover:border-zinc-900 hover:text-zinc-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-400 dark:border-zinc-600 dark:bg-[#1a1a1a] dark:text-zinc-300 dark:hover:border-zinc-100 dark:hover:text-zinc-100 dark:focus-visible:outline-zinc-500"
		aria-label="Toggle theme"
		title="Toggle theme"
	>
		<span class="sr-only">Toggle theme</span>
		<!-- Moon icon (shown in light mode) -->
		<svg
			class="h-5 w-5 dark:hidden"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
		</svg>
		<!-- Sun icon (shown in dark mode) -->
		<svg
			class="hidden h-5 w-5 dark:inline"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2" />
			<path d="M12 20v2" />
			<path d="M4.93 4.93l1.41 1.41" />
			<path d="M17.66 17.66l1.41 1.41" />
			<path d="M2 12h2" />
			<path d="M20 12h2" />
			<path d="M4.93 19.07l1.41-1.41" />
			<path d="M17.66 6.34l1.41-1.41" />
		</svg>
	</button>
	<div
		class="mx-auto flex max-w-3xl flex-col items-center px-4 text-center"
	>
		<a
			href="/"
			class="text-3xl font-semibold uppercase tracking-[0.18em] text-zinc-900 no-underline dark:text-zinc-100"
		>
			{SITE_TITLE}
		</a>
		<p class="mt-3 max-w-2xl text-sm text-zinc-500 dark:text-zinc-400">
			I read, I create, I experience
		</p>
		<nav class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs font-medium uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/posts">Posts</HeaderLink>
			<HeaderLink href="/archive">Archive</HeaderLink>
		</nav>
	</div>
	</header>

<script is:inline>
	(() => {
		const storageKey = 'theme';
		const root = document.documentElement;
		const button = document.getElementById('theme-toggle');

		if (!(button instanceof HTMLButtonElement)) return;

		const getStoredTheme = () => {
			try {
				return localStorage.getItem(storageKey);
			} catch {
				return null;
			}
		};

		const setStoredTheme = (theme) => {
			try {
				localStorage.setItem(storageKey, theme);
			} catch {
				// Ignore write errors (private mode, blocked storage, etc.)
			}
		};

		const applyTheme = (theme, { persist } = { persist: false }) => {
			const isDark = theme === 'dark';
			root.classList.toggle('dark', isDark);
			root.style.colorScheme = isDark ? 'dark' : 'light';
			button.setAttribute('aria-pressed', String(isDark));

			if (persist) setStoredTheme(theme);
			window.dispatchEvent(
				new CustomEvent('theme-change', { detail: { theme } }),
			);
		};

		// Initialize pressed state.
		const initialIsDark = root.classList.contains('dark');
		button.setAttribute('aria-pressed', String(initialIsDark));

		button.addEventListener('click', () => {
			const isDark = root.classList.contains('dark');
			applyTheme(isDark ? 'light' : 'dark', { persist: true });
		});

		// If the user hasn't set a preference, keep in sync with system changes.
		const mql = window.matchMedia?.('(prefers-color-scheme: dark)');
		mql?.addEventListener?.('change', (event) => {
			if (getStoredTheme() !== null) return;
			applyTheme(event.matches ? 'dark' : 'light');
		});

	})();
</script>

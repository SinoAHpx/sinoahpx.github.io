---
const today = new Date();
---

<footer class="mt-12 border-t border-zinc-200 dark:border-zinc-700">
  <div class="mx-auto max-w-3xl px-4 py-6 text-center font-sans text-xs text-zinc-400 dark:text-zinc-500">
    &copy; {today.getFullYear()} AHpx. All rights reserved.
    <a
      href="/rss.xml"
      class="ml-3 inline-block uppercase tracking-[0.18em] text-zinc-400 no-underline hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100"
    >
      RSS
    </a>
    <div class="mt-2">
      Build with <a href="https://astro.build/">Astro</a>, handcrafted theme.
    </div>
  </div>
</footer>

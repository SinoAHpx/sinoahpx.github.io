---
const today = new Date();
---

<footer class="mt-16 pb-10">
  <div class="mx-auto max-w-2xl px-4 text-center font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
    <div>&copy; {today.getFullYear()} AHpx</div>
    <div class="mt-1">
      <a
        href="/rss.xml"
        class="text-ink-faint no-underline hover:text-ink dark:text-ink-faint-dark dark:hover:text-ink-dark"
      >
        RSS
      </a>
    </div>
  </div>
</footer>

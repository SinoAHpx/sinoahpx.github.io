---
const today = new Date();
---

<footer class="mt-12 border-t border-zinc-200">
	<div class="mx-auto max-w-3xl px-4 py-6 text-center text-xs text-zinc-500">
		&copy; {today.getFullYear()} Your name here. All rights reserved.
		<a
			href="/rss.xml"
			class="ml-3 inline-block font-medium uppercase tracking-[0.18em] text-zinc-500 no-underline hover:text-zinc-900"
		>
			RSS
		</a>
	</div>
</footer>

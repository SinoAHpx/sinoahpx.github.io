---
const today = new Date();
---

<footer
	class="px-4 pt-8 pb-10 text-center text-[rgb(var(--gray))]"
	style="background: linear-gradient(var(--gray-gradient)) no-repeat;"
>
	&copy; {today.getFullYear()} Your name here. All rights reserved.
	<a
		href="/rss.xml"
		class="inline-block mt-3 text-[0.9rem] text-[rgb(var(--gray))] no-underline uppercase tracking-[0.12em] hover:text-[rgb(var(--gray-dark))]"
	>
		RSS
	</a>
</footer>

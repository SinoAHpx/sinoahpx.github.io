---
import TableOfContentsList from './TableOfContentsList.astro';

interface HeadingLink {
	depth: number;
	slug: string;
	text: string;
}

interface TocItem extends HeadingLink {
	children: TocItem[];
}

interface Props {
	headings?: HeadingLink[];
	title?: string;
}

const { headings = [], title = 'On this page' } = Astro.props as Props;

const normalizedHeadings = headings.filter(
	(heading) => heading.depth >= 2 && heading.slug.trim().length > 0,
);

const root: TocItem = {
	depth: 1,
	slug: '',
	text: '',
	children: [],
};
const stack: TocItem[] = [root];

for (const heading of normalizedHeadings) {
	const item: TocItem = { ...heading, children: [] };

	while (
		stack.length > 1 &&
		heading.depth <= stack[stack.length - 1].depth
	) {
		stack.pop();
	}

	stack[stack.length - 1].children.push(item);
	stack.push(item);
}

const tocItems = root.children;
---

{
	tocItems.length > 0 && (
		<aside class="absolute left-full top-0 ml-6 hidden h-full min-[1120px]:block">
			<nav
				aria-label={title}
				data-toc-nav
				class="sticky top-24 w-44"
			>
				<p class="mb-2 font-sans text-[11px] text-ink-faint dark:text-ink-faint-dark">
					{title}
				</p>
				<div data-toc-scroll-root class="max-h-[68vh] overflow-y-auto">
					<TableOfContentsList items={tocItems} />
				</div>
			</nav>
		</aside>
	)
}

<script is:inline>
	(() => {
		const tocNavs = Array.from(document.querySelectorAll('[data-toc-nav]'));
		if (tocNavs.length === 0) return;

		const ACTIVE_CLASSES = ['text-ink', 'dark:text-ink-dark'];

		for (const tocNav of tocNavs) {
			const links = Array.from(
				tocNav.querySelectorAll('a[data-toc-link][data-toc-slug]'),
			);
			if (links.length === 0) continue;

			const scrollRoot = tocNav.querySelector('[data-toc-scroll-root]');
			const items = links
				.map((link) => {
					const slug = link.getAttribute('data-toc-slug');
					if (!slug) return null;

					const section = document.getElementById(slug);
					if (!section) return null;

					return { slug, link, section };
				})
				.filter((item) => item !== null);

			if (items.length === 0) continue;

			let activeSlug = '';
			let ticking = false;

			const scrollActiveIntoView = (link) => {
				if (!(scrollRoot instanceof HTMLElement)) return;

				const top = link.offsetTop;
				const bottom = top + link.offsetHeight;
				const viewTop = scrollRoot.scrollTop;
				const viewBottom = viewTop + scrollRoot.clientHeight;

				if (top < viewTop) {
					scrollRoot.scrollTo({ top: Math.max(top - 6, 0), behavior: 'smooth' });
					return;
				}

				if (bottom > viewBottom) {
					scrollRoot.scrollTo({
						top: bottom - scrollRoot.clientHeight + 6,
						behavior: 'smooth',
					});
				}
			};

			const setActive = (slug) => {
				if (!slug || slug === activeSlug) return;
				activeSlug = slug;

				for (const item of items) {
					const isActive = item.slug === slug;
					for (const className of ACTIVE_CLASSES) {
						item.link.classList.toggle(className, isActive);
					}

					if (isActive) {
						item.link.setAttribute('aria-current', 'location');
						scrollActiveIntoView(item.link);
					} else {
						item.link.removeAttribute('aria-current');
					}
				}
			};

			const getHashSlug = () => {
				if (!window.location.hash) return '';
				return decodeURIComponent(window.location.hash.slice(1));
			};

			const getActiveSlug = () => {
				const hashSlug = getHashSlug();
				if (hashSlug && items.some((item) => item.slug === hashSlug)) {
					return hashSlug;
				}

				const offset = 150;
				let currentSlug = items[0].slug;

				for (const item of items) {
					if (item.section.getBoundingClientRect().top - offset <= 0) {
						currentSlug = item.slug;
					} else {
						break;
					}
				}

				return currentSlug;
			};

			const syncActive = () => {
				ticking = false;
				setActive(getActiveSlug());
			};

			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(syncActive);
			};

			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('hashchange', syncActive);

			syncActive();
		}
	})();
</script>

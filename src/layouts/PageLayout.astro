---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface HeadingLink {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description?: string;
	date: Date;
	toc?: boolean;
	headings?: HeadingLink[];
}

const { title, description, date, toc = true, headings = [] } = Astro.props as Props;
const showToc = toc && headings.length > 0;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description ?? title} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<div class="relative">
				<article
					class="overflow-hidden border border-zinc-300 bg-white dark:border-zinc-600 dark:bg-[#222]"
				>
					<div
						class="prose prose-zinc dark:prose-invert max-w-none px-6 pb-8 pt-6 text-sm leading-relaxed"
					>
						<header class="mb-6 text-center not-prose">
							<h1 class="mb-2 text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
								{title}
							</h1>
							{
								description && (
									<p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
										{description}
									</p>
								)
							}
							<p class="mt-2 text-xs text-zinc-400 dark:text-zinc-400">
								<FormattedDate date={date} />
							</p>
						</header>

						<slot />
					</div>
				</article>
				{showToc && <TableOfContents headings={headings} />}
			</div>
		</main>
		<Footer />
	</body>
</html>

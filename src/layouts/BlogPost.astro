---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface HeadingLink {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: HeadingLink[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	categories = [],
	toc = true,
	headings = [],
} = Astro.props as Props;
const showToc = toc && headings.length > 0;

// Build combined list of category and tag links for the post footer.
const metaLinks = [
	...categories.map((category) => ({
		href: `/archive/categories/${encodeURIComponent(category)}/`,
		label: category,
	})),
	...tags.map((tag) => ({
		href: `/archive/tags/${encodeURIComponent(tag)}/`,
		label: `#${tag}`,
	})),
];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description ?? title} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<div class="relative">
				<article>
					{heroImage && (
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt=""
							class="mb-6 h-64 w-full object-cover sm:h-72"
						/>
					)}
					<div
						class="prose prose-zinc dark:prose-invert max-w-none pb-8 pt-2 text-sm leading-relaxed"
					>
						<header class="mb-8 not-prose">
							<h1 class="mb-2 text-2xl font-normal tracking-tight text-zinc-900 dark:text-zinc-100">
								{title}
							</h1>
							<div
								class="flex flex-wrap items-center gap-2 font-sans text-xs text-zinc-400 dark:text-zinc-500"
							>
								<span class="whitespace-nowrap">
									<FormattedDate date={pubDate} />
									{
										updatedDate && (
											<span class="italic">
												{' '}
												(Updated <FormattedDate date={updatedDate} />)
											</span>
										)
									}
								</span>
							</div>
						</header>
						<slot />

						<footer
							class="mt-10 flex flex-wrap items-center justify-between border-t border-zinc-200 pt-4 font-sans text-xs text-zinc-400 not-prose dark:border-zinc-700 dark:text-zinc-500"
						>
							<span class="whitespace-nowrap">
								<FormattedDate date={pubDate} />
							</span>
							<div class="flex flex-wrap justify-end text-right">
								{metaLinks.map((item, index) => (
									<>
										{index > 0 && (
											<span class="mx-1 text-zinc-300 dark:text-zinc-600">/</span>
										)}
										<a
											href={item.href}
											class="text-zinc-400 no-underline hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100"
										>
											{item.label}
										</a>
									</>
								))}
							</div>
						</footer>
					</div>
				</article>
				<Giscus />
				{showToc && <TableOfContents headings={headings} />}
			</div>
		</main>
		<Footer />
	</body>
</html>

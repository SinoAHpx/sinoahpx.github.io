---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	tags?: string[];
	categories?: string[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	categories = [],
} = Astro.props as Props;

const categoriesLabel = categories.join(', ');
const tagsLabel = tags.map((tag) => `#${tag}`).join(' ');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				margin: 0;
				padding: 2rem 1rem 3rem 1rem;
			}
			.post-card {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				border-radius: 12px;
				border: 1px solid rgb(var(--gray-light));
				background: #fff;
				overflow: hidden;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 12px 12px 0 0;
			}
			.prose {
				padding: 1.5rem 1.75rem 2rem 1.75rem;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
				line-height: 1.7;
			}
			.title {
				margin-bottom: 1rem;
				padding: 0 0 1rem 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2rem;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: baseline;
				gap: 0.35rem;
				margin-top: 0.5rem;
				color: rgb(var(--gray));
				font-size: 0.85rem;
			}
			.meta-separator {
				color: rgb(var(--gray));
			}
			.meta-part {
				white-space: nowrap;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="post-card">
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="meta">
							<span class="meta-part">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="last-updated-on">
											{' '}
											(Updated <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</span>
							{categoriesLabel && (
								<>
									<span class="meta-separator">/</span>
									<span class="meta-part">{categoriesLabel}</span>
								</>
							)}
							{tagsLabel && (
								<>
									<span class="meta-separator">/</span>
									<span class="meta-part">{tagsLabel}</span>
								</>
							)}
						</div>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

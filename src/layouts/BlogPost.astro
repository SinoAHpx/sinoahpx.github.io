---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	tags?: string[];
	categories?: string[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	categories = [],
} = Astro.props as Props;

const categoriesLabel = categories.join(', ');
const tagsLabel = tags.map((tag) => `#${tag}`).join(' ');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<article
				class="overflow-hidden rounded-xl border border-zinc-200 bg-white/80"
			>
				{heroImage && (
					<Image
						width={1020}
						height={510}
						src={heroImage}
						alt=""
						class="h-64 w-full object-cover sm:h-72"
					/>
				)}
				<div
					class="prose prose-zinc max-w-none px-6 pb-8 pt-6 text-sm leading-relaxed"
				>
					<header class="mb-6 text-center not-prose">
						<h1 class="mb-2 text-2xl font-semibold tracking-tight text-zinc-900">
							{title}
						</h1>
						<div
							class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-zinc-500"
						>
							<span class="whitespace-nowrap">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="italic">
											{' '}
											(Updated <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</span>
							{categoriesLabel && (
								<>
									<span aria-hidden="true">•</span>
									<span class="whitespace-nowrap">{categoriesLabel}</span>
								</>
							)}
							{tagsLabel && (
								<>
									<span aria-hidden="true">•</span>
									<span class="whitespace-nowrap">{tagsLabel}</span>
								</>
							)}
						</div>
					</header>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

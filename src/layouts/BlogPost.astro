---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	tags?: string[];
	categories?: string[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	categories = [],
} = Astro.props as Props;

const categoriesLabel = categories.join(', ');
const tagsLabel = tags.map((tag) => `#${tag}`).join(' ');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="w-full m-0 px-4 pt-8 pb-12">
			<article
				class="w-[720px] max-w-full mx-auto rounded-xl border border-[rgb(var(--gray-light))] bg-white overflow-hidden"
			>
				<div>
					{heroImage && (
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt=""
							class="block w-full rounded-t-xl"
						/>
					)}
				</div>
				<div
					class="prose prose-p:mb-[2em] px-[1.75rem] pt-6 pb-8 text-[0.95rem] leading-[1.7] text-[rgb(var(--gray-dark))]"
				>
					<div class="mb-4 pb-4 text-center leading-[1]">
						<h1 class="m-0 mb-2 text-2xl">{title}</h1>
						<div
							class="mt-2 flex flex-wrap justify-center items-baseline gap-1.5 text-[0.85rem] text-[rgb(var(--gray))]"
						>
							<span class="whitespace-nowrap">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="italic">
											{' '}
											(Updated <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</span>
							{categoriesLabel && (
								<>
									<span class="text-[rgb(var(--gray))]">/</span>
									<span class="whitespace-nowrap">{categoriesLabel}</span>
								</>
							)}
							{tagsLabel && (
								<>
									<span class="text-[rgb(var(--gray))]">/</span>
									<span class="whitespace-nowrap">{tagsLabel}</span>
								</>
							)}
						</div>
						<hr class="mt-4 border-t border-[rgb(var(--gray-light))]" />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface HeadingLink {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: HeadingLink[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	categories = [],
	toc = true,
	headings = [],
} = Astro.props as Props;
const showToc = toc && headings.length > 0;

const metaLinks = [
	...categories.map((category) => ({
		href: `/archive/categories/${encodeURIComponent(category)}/`,
		label: category,
	})),
	...tags.map((tag) => ({
		href: `/archive/tags/${encodeURIComponent(tag)}/`,
		label: `#${tag}`,
	})),
];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description ?? title} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-4 pb-12">
			<div class="relative">
				<article>
					{heroImage && (
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt=""
							class="mb-8 h-64 w-full object-cover sm:h-72"
						/>
					)}
					<div
						class="prose prose-zinc dark:prose-invert max-w-none pb-8 text-sm leading-relaxed"
					>
						<header class="mb-10 not-prose">
							<h1 class="text-2xl leading-snug text-ink dark:text-ink-dark">
								{title}
							</h1>
							<div
								class="mt-3 font-sans text-xs text-ink-faint dark:text-ink-faint-dark"
							>
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="italic">
											{' '}(Updated <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</div>
						</header>
						<slot />

						<footer
							class="mt-12 not-prose"
						>
							<div class="flex justify-center mb-6">
								<span class="block h-px w-16 bg-ink-faint/30 dark:bg-ink-faint-dark/50" />
							</div>
							<div class="flex flex-wrap items-center justify-between font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
								<span>
									<FormattedDate date={pubDate} />
								</span>
								<div class="flex flex-wrap justify-end text-right">
									{metaLinks.map((item, index) => (
										<>
											{index > 0 && (
												<span class="mx-1">/</span>
											)}
											<a
												href={item.href}
												class="no-underline hover:text-ink dark:hover:text-ink-dark"
											>
												{item.label}
											</a>
										</>
									))}
								</div>
							</div>
						</footer>
					</div>
				</article>
				<Giscus />
				{showToc && <TableOfContents headings={headings} />}
			</div>
		</main>
		<Footer />
	</body>
</html>

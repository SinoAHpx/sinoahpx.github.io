---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	tags?: string[];
	categories?: string[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	categories = [],
} = Astro.props as Props;

// Build combined list of category and tag links for the post footer.
const metaLinks = [
	...categories.map((category) => ({
		href: `/archive/categories/${encodeURIComponent(category)}/`,
		label: category,
	})),
	...tags.map((tag) => ({
		href: `/archive/tags/${encodeURIComponent(tag)}/`,
		label: `#${tag}`,
	})),
];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<article
				class="overflow-hidden rounded-xl border border-zinc-200 bg-white/80"
			>
				{heroImage && (
					<Image
						width={1020}
						height={510}
						src={heroImage}
						alt=""
						class="h-64 w-full object-cover sm:h-72"
					/>
				)}
				<div
					class="prose prose-zinc max-w-none px-6 pb-8 pt-6 text-sm leading-relaxed"
				>
					<header class="mb-6 text-center not-prose">
						<h1 class="mb-2 text-2xl font-semibold tracking-tight text-zinc-900">
							{title}
						</h1>
						<div
							class="flex flex-wrap items-center justify-center gap-2 text-xs text-zinc-500"
						>
							<span class="whitespace-nowrap">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="italic">
											{' '}
											(Updated <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</span>
						</div>
					</header>
					<slot />

					<footer
						class="mt-8 flex flex-wrap items-center justify-between border-t border-zinc-200 pt-4 text-xs text-zinc-400 not-prose"
					>
						<span class="whitespace-nowrap">
							<FormattedDate date={pubDate} />
						</span>
						<div class="flex flex-wrap justify-end text-right">
							{metaLinks.map((item, index) => (
								<>
									{index > 0 && (
										<span class="mx-1 text-zinc-400">/</span>
									)}
									<a
										href={item.href}
										class="text-zinc-500 no-underline hover:text-zinc-900 hover:underline"
									>
										{item.label}
									</a>
								</>
							))}
						</div>
					</footer>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

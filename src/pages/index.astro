---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const PAGE_SIZE = 10;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const page = 1;
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE) || 1;
const posts = allPosts.slice(0, PAGE_SIZE);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-4 pb-12">
			<ul>
				{
					posts.map((post, i) => (
						<li>
							<a
								href={`/posts/${post.id}/`}
								class="group block py-7 no-underline"
							>
								{post.data.heroImage && (
									<div class="mb-5 overflow-hidden">
										<Image
											width={720}
											height={360}
											src={post.data.heroImage}
											alt=""
											class="aspect-[3/1] w-full object-cover"
										/>
									</div>
								)}
								<h2 class="text-lg leading-relaxed text-ink transition group-hover:text-ink-light dark:text-ink-dark dark:group-hover:text-ink-light-dark">
									{post.data.title}
								</h2>
								<span class="mt-2 block font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
							{i < posts.length - 1 && (
								<div class="flex justify-center">
									<span class="block h-px w-10 bg-ink-faint/25 dark:bg-ink-faint-dark/40" />
								</div>
							)}
						</li>
					))
				}
			</ul>

			{
				totalPages > 1 && (
					<nav class="mt-14 flex items-center justify-between font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
						<span />
						<span>{page} / {totalPages}</span>
						<a
							class="no-underline text-ink-light hover:text-ink dark:text-ink-light-dark dark:hover:text-ink-dark"
							href="/posts/page/2/"
						>
							后页 &rarr;
						</a>
					</nav>
				)
			}
		</main>
		<Footer />
	</body>
</html>

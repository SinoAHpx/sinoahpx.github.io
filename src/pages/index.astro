---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const PAGE_SIZE = 10;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const page = 1;
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE) || 1;
const posts = allPosts.slice(0, PAGE_SIZE);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul class="list-none m-0 p-0 flex flex-col gap-6">
					{
						posts.map((post) => (
							<li
								class="rounded-xl border border-[rgb(var(--gray-light))] bg-white overflow-hidden"
							>
								<a href={`/blog/${post.id}/`} class="block px-6 py-5 no-underline">
									{post.data.heroImage && (
										<div class="mt-[-1.25rem] mx-[-1.5rem] mb-4">
											<Image
												width={720}
												height={360}
												src={post.data.heroImage}
												alt=""
												class="w-full block rounded-t-xl"
											/>
										</div>
									)}
									<h2 class="m-0 mb-1 text-[1.2rem] text-[rgb(var(--black))]">
										{post.data.title}
									</h2>
									<p class="m-0 mb-2 text-[0.9rem] text-[rgb(var(--gray))]">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="m-0 text-[0.95rem] text-[rgb(var(--gray-dark))]">
										{post.data.description}
									</p>
								</a>
							</li>
						))
					}
				</ul>

				{
					totalPages > 1 && (
						<nav
							class="mt-8 flex items-center justify-between text-[0.9rem] text-[rgb(var(--gray))]"
						>
							<span />

							<span class="flex-1 text-center">
								Page {page} of {totalPages}
							</span>

							<a
								class="text-[rgb(var(--gray))] no-underline uppercase tracking-[0.12em] hover:text-[rgb(var(--black))]"
								href="/page/2/"
							>
								Older posts →
							</a>
						</nav>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

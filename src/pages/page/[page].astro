---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

type Post = CollectionEntry<'blog'>;

type Props = {
	page: number;
	totalPages: number;
	posts: Post[];
};

export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	const totalPages = Math.ceil(allPosts.length / 10);

	if (totalPages <= 1) {
		return [];
	}

	// We already render page 1 at `/` via src/pages/index.astro
	// so here we only generate /page/2, /page/3, ...
	return Array.from({ length: totalPages - 1 }).map((_, i) => {
		const page = i + 2;
		const start = (page - 1) * 10;
		const end = start + 10;

		return {
			params: { page: String(page) },
			props: {
				page,
				totalPages,
				posts: allPosts.slice(start, end),
			},
		};
	});
}

const { page, totalPages, posts } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.post-card {
				border-radius: 12px;
				border: 1px solid rgb(var(--gray-light));
				background: #fff;
				overflow: hidden;
			}
			.post-card a {
				display: block;
				padding: 1.25rem 1.5rem;
				color: inherit;
				text-decoration: none;
			}
			.post-title {
				margin: 0 0 0.25rem 0;
				font-size: 1.2rem;
				color: rgb(var(--black));
			}
			.post-meta {
				margin: 0 0 0.5rem 0;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.post-description {
				margin: 0;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
			}
			.post-hero {
				margin: -1.25rem -1.5rem 1rem -1.5rem;
			}
			.post-hero img {
				border-radius: 12px 12px 0 0;
				display: block;
				width: 100%;
			}
			.pagination {
				margin-top: 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.page-link {
				color: rgb(var(--gray));
				text-decoration: none;
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}
			.page-link:hover {
				color: rgb(var(--black));
			}
			.page-info {
				flex: 1;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<div class="post-hero">
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										</div>
									)}
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="post-description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>

				{
					totalPages > 1 && (
						<nav class="pagination">
							<a
								class="page-link"
								href={page === 2 ? '/' : `/page/${page - 1}/`}
							>
								← Newer posts
							</a>

							<span class="page-info">
								Page {page} of {totalPages}
							</span>

							{page < totalPages ? (
								<a class="page-link" href={`/page/${page + 1}/`}>
									Older posts →
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

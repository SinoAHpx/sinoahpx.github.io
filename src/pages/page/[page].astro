---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

type Post = CollectionEntry<'blog'>;

type Props = {
	page: number;
	totalPages: number;
	posts: Post[];
};

function formatCategoriesAndTags(post: Post) {
	const categories = post.data.categories ?? [];
	const tags = post.data.tags ?? [];
	const parts = [
		...categories,
		...tags.map((tag) => `#${tag}`),
	];
	return parts.join(' / ');
}

export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	const totalPages = Math.ceil(allPosts.length / 10);

	if (totalPages <= 1) {
		return [];
	}

	// We already render page 1 at `/` via src/pages/index.astro
	// so here we only generate /page/2, /page/3, ...
	return Array.from({ length: totalPages - 1 }).map((_, i) => {
		const page = i + 2;
		const start = (page - 1) * 10;
		const end = start + 10;

		return {
			params: { page: String(page) },
			props: {
				page,
				totalPages,
				posts: allPosts.slice(start, end),
			},
		};
	});
}

const { page, totalPages, posts } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<section class="space-y-8">
				<ul class="space-y-5">
					{
						posts.map((post) => (
							<li>
								<a
									href={`/blog/${post.id}/`}
									class="block rounded-xl border border-zinc-200 bg-white/80 p-5 no-underline transition hover:border-zinc-300 hover:bg-white"
								>
									{post.data.heroImage && (
										<div class="mb-4 overflow-hidden rounded-lg">
											<Image
												width={720}
												height={360}
												src={post.data.heroImage}
												alt=""
												class="aspect-[3/1] w-full object-cover"
											/>
										</div>
									)}
									<h2 class="mb-1 text-base font-semibold leading-snug text-zinc-900">
										{post.data.title}
									</h2>
									<p class="mt-2 text-sm text-zinc-600">
										{post.data.description ?? post.data.title}
									</p>
									<div
										class="mt-4 flex items-center justify-between text-xs text-zinc-400"
									>
										<span>
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="truncate text-right">
											{formatCategoriesAndTags(post)}
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>

				{
					totalPages > 1 && (
						<nav
							class="mt-10 flex items-center justify-between text-xs text-zinc-500"
						>
							<a
								class="no-underline uppercase tracking-[0.18em] text-zinc-500 hover:text-zinc-900"
								href={page === 2 ? '/' : `/page/${page - 1}/`}
							>
								← Newer posts
							</a>

							<span class="flex-1 text-center">
								Page {page} of {totalPages}
							</span>

							{page < totalPages ? (
								<a
									class="no-underline uppercase tracking-[0.18em] text-zinc-500 hover:text-zinc-900"
									href={`/page/${page + 1}/`}
								>
									Older posts →
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

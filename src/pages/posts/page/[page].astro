---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;

type Props = {
	page: number;
	totalPages: number;
	posts: Post[];
};

function formatCategoriesAndTags(post: Post) {
	const categories = post.data.categories ?? [];
	const tags = post.data.tags ?? [];
	const parts = [...categories, ...tags.map((tag) => `#${tag}`)];
	return parts.join(' / ');
}

export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	const totalPages = Math.ceil(allPosts.length / 10);

	if (totalPages <= 1) {
		return [];
	}

	return Array.from({ length: totalPages - 1 }).map((_, i) => {
		const page = i + 2;
		const start = (page - 1) * 10;
		const end = start + 10;

		return {
			params: { page: String(page) },
			props: {
				page,
				totalPages,
				posts: allPosts.slice(start, end),
			},
		};
	});
}

const { page, totalPages, posts } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-4 pb-12">
			<ul>
				{
					posts.map((post, i) => (
						<li>
							<a
								href={`/posts/${post.id}/`}
								class="block py-8 no-underline transition hover:opacity-70"
							>
								{post.data.heroImage && (
									<div class="mb-5 overflow-hidden">
										<Image
											width={720}
											height={360}
											src={post.data.heroImage}
											alt=""
											class="aspect-[3/1] w-full object-cover"
										/>
									</div>
								)}
								<h2 class="text-lg leading-snug text-ink dark:text-ink-dark">
									{post.data.title}
								</h2>
								<p class="mt-3 text-sm leading-relaxed text-ink-light dark:text-ink-light-dark">
									{post.data.description ?? post.data.title}
								</p>
								<div class="mt-4 flex items-center justify-between font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
									<span>
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="truncate text-right">
										{formatCategoriesAndTags(post)}
									</span>
								</div>
							</a>
							{i < posts.length - 1 && (
								<div class="flex justify-center">
									<span class="block h-px w-16 bg-ink-faint/30 dark:bg-ink-faint-dark/50" />
								</div>
							)}
						</li>
					))
				}
			</ul>

			{
				totalPages > 1 && (
					<nav class="mt-12 grid grid-cols-3 items-center font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
						<div>
							<a
								class="no-underline text-ink-light hover:text-ink dark:text-ink-light-dark dark:hover:text-ink-dark"
								href={page === 2 ? '/' : `/posts/page/${page - 1}/`}
							>
								&larr; 前页
							</a>
						</div>

						<div class="text-center">{page} / {totalPages}</div>

						<div class="text-right">
							{page < totalPages ? (
								<a
									class="no-underline text-ink-light hover:text-ink dark:text-ink-light-dark dark:hover:text-ink-dark"
									href={`/posts/page/${page + 1}/`}
								>
									后页 &rarr;
								</a>
							) : (
								<span aria-hidden="true" />
							)}
						</div>
					</nav>
				)
			}
		</main>
		<Footer />
	</body>
</html>

---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;

type Props = {
	page: number;
	totalPages: number;
	posts: Post[];
};

function formatCategoriesAndTags(post: Post) {
	const categories = post.data.categories ?? [];
	const tags = post.data.tags ?? [];
	const parts = [...categories, ...tags.map((tag) => `#${tag}`)];
	return parts.join(' / ');
}

export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	const totalPages = Math.ceil(allPosts.length / 10);

	if (totalPages <= 1) {
		return [];
	}

	// We already render page 1 at `/posts` via src/pages/posts/index.astro
	// so here we only generate /posts/page/2, /posts/page/3, ...
	return Array.from({ length: totalPages - 1 }).map((_, i) => {
		const page = i + 2;
		const start = (page - 1) * 10;
		const end = start + 10;

		return {
			params: { page: String(page) },
			props: {
				page,
				totalPages,
				posts: allPosts.slice(start, end),
			},
		};
	});
}

const { page, totalPages, posts } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<section class="space-y-8">
				<ul class="space-y-5">
					{
						posts.map((post) => (
							<li>
								<a
									href={`/posts/${post.id}/`}
									class="block border border-zinc-300 bg-white p-5 no-underline transition hover:border-zinc-900 dark:border-zinc-600 dark:bg-[#222] dark:hover:border-zinc-100"
								>
									{post.data.heroImage && (
										<div class="mb-4 overflow-hidden">
											<Image
												width={720}
												height={360}
												src={post.data.heroImage}
												alt=""
												class="aspect-[3/1] w-full object-cover"
											/>
										</div>
									)}
									<h2 class="mb-1 text-base font-semibold leading-snug text-zinc-900 dark:text-zinc-100">
										{post.data.title}
									</h2>
									<p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
										{post.data.description ?? post.data.title}
									</p>
									<div class="mt-4 flex items-center justify-between text-xs text-zinc-400">
										<span>
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="truncate text-right">
											{formatCategoriesAndTags(post)}
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>

				{
					totalPages > 1 && (
						<nav class="mt-10 grid grid-cols-3 items-center text-xs text-zinc-500 dark:text-zinc-400">
							<div>
								<a
									class="no-underline uppercase tracking-[0.18em] text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
									href={page === 2 ? '/posts/' : `/posts/page/${page - 1}/`}
								>
									← Newer posts
								</a>
							</div>

							<div class="text-center">Page {page} of {totalPages}</div>

							<div class="text-right">
								{page < totalPages ? (
									<a
										class="no-underline uppercase tracking-[0.18em] text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
										href={`/posts/page/${page + 1}/`}
									>
										Older posts →
									</a>
								) : (
									<span aria-hidden="true" />
								)}
							</div>
						</nav>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

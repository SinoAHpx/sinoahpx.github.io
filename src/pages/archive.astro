---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

type Post = CollectionEntry<'blog'>;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function groupByYear(posts: Post[]) {
	const groups = new Map<number, Post[]>();

	for (const post of posts) {
		const year = post.data.pubDate.getFullYear();
		const list = groups.get(year) ?? [];
		list.push(post);
		groups.set(year, list);
	}

	return Array.from(groups.entries()).sort((a, b) => b[0] - a[0]);
}

function groupByKey(posts: Post[], key: 'tags' | 'categories') {
	const groups = new Map<string, Post[]>();

	for (const post of posts) {
		const values =
			key === 'tags' ? post.data.tags ?? [] : post.data.categories ?? [];
		for (const value of values) {
			const trimmed = value.trim();
			if (!trimmed) continue;
			const list = groups.get(trimmed) ?? [];
			list.push(post);
			groups.set(trimmed, list);
		}
	}

	return Array.from(groups.entries()).sort(([a], [b]) =>
		a.localeCompare(b, 'en'),
	);
}

const dateGroups = groupByYear(allPosts);
const categoryGroups = groupByKey(allPosts, 'categories');
const tagGroups = groupByKey(allPosts, 'tags');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Archive – ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<section class="space-y-8">
				<header class="space-y-3">
					<h1 class="text-2xl font-semibold tracking-tight text-zinc-900">
						Archive
					</h1>
					<p class="text-sm text-zinc-600">
						Browse posts by date, category, or tag.
					</p>

					<nav class="mt-4 flex gap-3 text-xs font-medium text-zinc-500">
						<a
							href="/archive?view=date"
							data-archive-pill="date"
							class="inline-flex items-center rounded-full border border-zinc-900 bg-zinc-900 px-3 py-1 text-zinc-50 no-underline transition"
						>
							Date
						</a>
						<a
							href="/archive?view=categories"
							data-archive-pill="categories"
							class="inline-flex items-center rounded-full border border-zinc-200 bg-white/70 px-3 py-1 no-underline transition hover:border-zinc-300 hover:text-zinc-900"
						>
							Categories
						</a>
						<a
							href="/archive?view=tags"
							data-archive-pill="tags"
							class="inline-flex items-center rounded-full border border-zinc-200 bg-white/70 px-3 py-1 no-underline transition hover:border-zinc-300 hover:text-zinc-900"
						>
							Tags
						</a>
					</nav>
				</header>

				<div
					data-archive-view="date"
					class="space-y-8"
				>
					{
						dateGroups.map(([year, posts]) => (
							<section class="space-y-3" aria-labelledby={`year-${year}`}>
								<h2
									id={`year-${year}`}
									class="text-sm font-semibold uppercase tracking-[0.18em] text-zinc-500"
								>
									{year}
								</h2>
								<ul class="space-y-2 text-sm">
									{
										posts.map((post) => (
											<li class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
												<span class="w-24 shrink-0 text-xs text-zinc-400">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<a
													href={`/blog/${post.id}/`}
													class="flex-1 text-zinc-900 no-underline hover:underline"
												>
													{post.data.title}
												</a>
											</li>
										))
									}
								</ul>
							</section>
						))
					}
				</div>

				<div
					data-archive-view="categories"
					class="space-y-8 hidden"
				>
					{
						categoryGroups.map(([name, posts]) => (
							<section
								class="space-y-3"
								aria-labelledby={`category-${name}`}
								data-category-name={name}
							>
								<h2
									id={`category-${name}`}
									class="text-sm font-semibold text-zinc-900"
								>
									{name}
									<span class="ml-2 text-xs font-normal text-zinc-400">
										{posts.length} post{posts.length === 1 ? '' : 's'}
									</span>
								</h2>
								<ul class="space-y-2 text-sm">
									{
										posts.map((post) => (
											<li class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
												<span class="w-24 shrink-0 text-xs text-zinc-400">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<a
													href={`/blog/${post.id}/`}
													class="flex-1 text-zinc-900 no-underline hover:underline"
												>
													{post.data.title}
												</a>
											</li>
										))
									}
								</ul>
							</section>
						))
					}
				</div>

				<div
					data-archive-view="tags"
					class="space-y-8 hidden"
				>
					{
						tagGroups.map(([name, posts]) => (
							<section
								class="space-y-3"
								aria-labelledby={`tag-${name}`}
								data-tag-name={name}
							>
								<h2
									id={`tag-${name}`}
									class="text-sm font-semibold text-zinc-900"
								>
									#{name}
									<span class="ml-2 text-xs font-normal text-zinc-400">
										{posts.length} post{posts.length === 1 ? '' : 's'}
									</span>
								</h2>
								<ul class="space-y-2 text-sm">
									{
										posts.map((post) => (
											<li class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
												<span class="w-24 shrink-0 text-xs text-zinc-400">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<a
													href={`/blog/${post.id}/`}
													class="flex-1 text-zinc-900 no-underline hover:underline"
												>
													{post.data.title}
												</a>
											</li>
										))
									}
								</ul>
							</section>
						))
					}
				</div>

				<script>
					(function () {
						var params = new URLSearchParams(window.location.search);
						var view = params.get('view') || 'date';
						var activeCategory = params.get('category') || '';
						var activeTag = params.get('tag') || '';

						var views = ['date', 'categories', 'tags'];

						views.forEach(function (name) {
							var container = document.querySelector(
								'[data-archive-view=\"' + name + '\"]',
							);
							if (!container) return;
							if (name === view) {
								container.classList.remove('hidden');
							} else {
								container.classList.add('hidden');
							}
						});

						views.forEach(function (name) {
							var pill = document.querySelector(
								'[data-archive-pill=\"' + name + '\"]',
							);
							if (!pill) return;
							var isActive =
								name === view ||
								(!params.get('view') && name === 'date');
							pill.classList.toggle('border-zinc-900', isActive);
							pill.classList.toggle('bg-zinc-900', isActive);
							pill.classList.toggle('text-zinc-50', isActive);
							pill.classList.toggle('border-zinc-200', !isActive);
							pill.classList.toggle('bg-white/70', !isActive);
						});

						if (view === 'categories' && activeCategory) {
							document
								.querySelectorAll('[data-category-name]')
								.forEach(function (section) {
									var name = section.getAttribute(
										'data-category-name',
									);
									if (name === activeCategory) {
										section.classList.remove('hidden');
									} else {
										section.classList.add('hidden');
									}
								});
						}

						if (view === 'tags' && activeTag) {
							document
								.querySelectorAll('[data-tag-name]')
								.forEach(function (section) {
									var name = section.getAttribute('data-tag-name');
									if (name === activeTag) {
										section.classList.remove('hidden');
									} else {
										section.classList.add('hidden');
									}
								});
						}
					})();
				</script>
			</section>
		</main>
		<Footer />
	</body>
</html>

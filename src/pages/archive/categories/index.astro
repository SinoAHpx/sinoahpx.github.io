---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;
const allPosts = await getCollection('blog');

function groupByCategory(posts: Post[]) {
	const groups = new Map<string, Post[]>();
	for (const post of posts) {
		for (const category of post.data.categories ?? []) {
			const trimmed = category.trim();
			if (!trimmed) continue;
			const list = groups.get(trimmed) ?? [];
			list.push(post);
			groups.set(trimmed, list);
		}
	}
	return Array.from(groups.entries()).sort(([a], [b]) => a.localeCompare(b, 'en'));
}

const categoryGroups = groupByCategory(allPosts);
const currentView: 'date' | 'categories' | 'tags' = 'categories';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`归档 -- 分类 -- ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-4 pb-12">
			<section class="space-y-10">
				<header>
					<h1 class="text-2xl text-ink dark:text-ink-dark">归档</h1>
					<nav class="mt-6 flex gap-6 font-sans text-sm text-ink-light dark:text-ink-light-dark">
						<a href="/archive/" class:list={['no-underline', currentView === 'date' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>按时间</a>
						<a href="/archive/categories/" class:list={['no-underline', currentView === 'categories' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>按分类</a>
						<a href="/archive/tags/" class:list={['no-underline', currentView === 'tags' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>按标签</a>
					</nav>
				</header>

				<div class="space-y-10">
					{categoryGroups.map(([name, posts]) => (
						<section class="space-y-3" aria-labelledby={`category-${name}`}>
							<h2 id={`category-${name}`} class="text-sm text-ink dark:text-ink-dark">
								{name}
								<span class="ml-2 font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
									{posts.length}
								</span>
							</h2>
							<ul class="space-y-2 text-sm">
								{posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).map((post) => (
									<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
										<span class="w-24 shrink-0 font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<a href={`/posts/${post.id}/`} class="flex-1 text-ink no-underline hover:underline dark:text-ink-dark">
											{post.data.title}
										</a>
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const tags = new Set<string>();
	for (const post of allPosts) {
		for (const tag of post.data.tags ?? []) {
			const trimmed = tag.trim();
			if (!trimmed) continue;
			tags.add(trimmed);
		}
	}
	return Array.from(tags).map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

type Props = { tag: string };
const { tag } = Astro.props as Props;

const posts = (await getCollection('blog'))
	.filter((post) => (post.data.tags ?? []).some((t) => t.trim() === tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentView: 'date' | 'categories' | 'tags' = 'tags';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`归档 -- #${tag} -- ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-4 pb-12">
			<section class="space-y-10">
				<header>
					<h1 class="text-2xl text-ink dark:text-ink-dark">归档</h1>
					<p class="mt-3 text-sm text-ink-light dark:text-ink-light-dark">
						标签：<span class="text-ink dark:text-ink-dark">#{tag}</span>
					</p>
					<nav class="mt-6 flex gap-6 font-sans text-sm text-ink-light dark:text-ink-light-dark">
						<a href="/archive/" class:list={['no-underline', currentView === 'date' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>按时间</a>
						<a href="/archive/categories/" class:list={['no-underline', currentView === 'categories' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>按分类</a>
						<a href="/archive/tags/" class:list={['no-underline', currentView === 'tags' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>按标签</a>
					</nav>
				</header>

				<div class="space-y-3">
					<h2 class="text-sm text-ink dark:text-ink-dark">
						#{tag}
						<span class="ml-2 font-sans text-xs text-ink-faint dark:text-ink-faint-dark">{posts.length}</span>
					</h2>
					<ul class="space-y-2 text-sm">
						{posts.map((post) => (
							<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
								<span class="w-24 shrink-0 font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<a href={`/posts/${post.id}/`} class="flex-1 text-ink no-underline hover:underline dark:text-ink-dark">
									{post.data.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

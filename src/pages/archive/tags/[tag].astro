---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const tags = new Set<string>();
	for (const post of allPosts) {
		for (const tag of post.data.tags ?? []) {
			const trimmed = tag.trim();
			if (!trimmed) continue;
			tags.add(trimmed);
		}
	}
	return Array.from(tags).map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

type Props = { tag: string };
const { tag } = Astro.props as Props;

const posts = (await getCollection('blog'))
	.filter((post) => (post.data.tags ?? []).some((t) => t.trim() === tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentView: 'date' | 'categories' | 'tags' = 'tags';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`归档 -- #${tag} -- ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-6 pb-16 lg:mx-0 lg:ml-20 lg:mr-56 lg:pt-14">
			<nav class="flex gap-6 text-sm text-ink-light dark:text-ink-light-dark">
				<a href="/archive/" class:list={['no-underline', currentView === 'date' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>时间</a>
				<a href="/archive/categories/" class:list={['no-underline', currentView === 'categories' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>分类</a>
				<a href="/archive/tags/" class:list={['no-underline', currentView === 'tags' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>标签</a>
			</nav>

			<div class="mt-12">
				<h2 class="mb-6 text-xl text-ink-light dark:text-ink-light-dark">
					#{tag}
					<span class="ml-2 text-sm text-ink-faint dark:text-ink-faint-dark">{posts.length}</span>
				</h2>
				<ul class="space-y-5">
					{posts.map((post) => (
						<li>
							<a href={`/posts/${post.id}/`} class="block text-ink no-underline hover:opacity-70 dark:text-ink-dark">
								{post.data.title}
							</a>
							<span class="mt-1 block font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))}
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const tags = new Set<string>();

	for (const post of allPosts) {
		for (const tag of post.data.tags ?? []) {
			const trimmed = tag.trim();
			if (!trimmed) continue;
			tags.add(trimmed);
		}
	}

	return Array.from(tags).map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

type Props = {
	tag: string;
};

const { tag } = Astro.props as Props;

const posts = (await getCollection('blog'))
	.filter((post) =>
		(post.data.tags ?? []).some(
			(t) => t.trim() === tag,
		),
	)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentView: 'date' | 'categories' | 'tags' = 'tags';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Archive – Tag: #${tag} – ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<section class="space-y-8">
				<header class="space-y-3">
					<h1 class="text-2xl font-semibold tracking-tight text-zinc-900">
						Archive
					</h1>
					<p class="text-sm text-zinc-600">
						Browse posts tagged{' '}
						<span class="font-medium text-zinc-900">#{tag}</span>.
					</p>

					<nav class="mt-4 flex gap-3 text-xs font-medium text-zinc-500">
						<a
							href="/archive/"
							class:list={[
								'inline-flex items-center rounded-full border px-3 py-1 no-underline transition',
								currentView === 'date'
									? 'border-zinc-900 bg-zinc-900 text-zinc-50'
									: 'border-zinc-200 bg-white/70 hover:border-zinc-300 hover:text-zinc-900',
							]}
						>
							Date
						</a>
						<a
							href="/archive/categories/"
							class:list={[
								'inline-flex items-center rounded-full border px-3 py-1 no-underline transition',
								currentView === 'categories'
									? 'border-zinc-900 bg-zinc-900 text-zinc-50'
									: 'border-zinc-200 bg-white/70 hover:border-zinc-300 hover:text-zinc-900',
							]}
						>
							Categories
						</a>
						<a
							href="/archive/tags/"
							class:list={[
								'inline-flex items-center rounded-full border px-3 py-1 no-underline transition',
								currentView === 'tags'
									? 'border-zinc-900 bg-zinc-900 text-zinc-50'
									: 'border-zinc-200 bg-white/70 hover:border-zinc-300 hover:text-zinc-900',
							]}
						>
							Tags
						</a>
					</nav>
				</header>

				<div class="space-y-3">
					<h2 class="text-sm font-semibold text-zinc-900">
						#{tag}
						<span class="ml-2 text-xs font-normal text-zinc-400">
							{posts.length} post{posts.length === 1 ? '' : 's'}
						</span>
					</h2>
					<ul class="space-y-2 text-sm">
						{
							posts.map((post) => (
								<li class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
									<span class="w-24 shrink-0 text-xs text-zinc-400">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<a
										href={`/blog/${post.id}/`}
										class="flex-1 text-zinc-900 no-underline hover:underline"
									>
										{post.data.title}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>


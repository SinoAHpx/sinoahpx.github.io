---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;

const allPosts = await getCollection('blog');

function groupByTag(posts: Post[]) {
	const groups = new Map<string, Post[]>();

	for (const post of posts) {
		const tags = post.data.tags ?? [];
		for (const tag of tags) {
			const trimmed = tag.trim();
			if (!trimmed) continue;
			const list = groups.get(trimmed) ?? [];
			list.push(post);
			groups.set(trimmed, list);
		}
	}

	return Array.from(groups.entries()).sort(([a], [b]) =>
		a.localeCompare(b, 'en'),
	);
}

const tagGroups = groupByTag(allPosts);
const currentView: 'date' | 'categories' | 'tags' = 'tags';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Archive – Tags – ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 pb-12 pt-8">
			<section class="space-y-8">
				<header class="space-y-3">
					<h1 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
						Archive
					</h1>
					<p class="text-sm text-zinc-600 dark:text-zinc-300">
						Browse posts by tag.
					</p>

					<nav class="mt-4 flex gap-3 text-xs font-medium text-zinc-500 dark:text-zinc-400">
						<a
							href="/archive/"
							class:list={[
								'inline-flex items-center border px-3 py-1 no-underline transition',
								currentView === 'date'
									? 'border-zinc-900 bg-zinc-900 text-zinc-50 dark:border-zinc-200 dark:bg-zinc-200 dark:text-zinc-900'
									: 'border-zinc-300 bg-white hover:border-zinc-900 hover:text-zinc-900 dark:border-zinc-600 dark:bg-[#222] dark:hover:border-zinc-100 dark:hover:text-zinc-100',
							]}
						>
							Date
						</a>
						<a
							href="/archive/categories/"
							class:list={[
								'inline-flex items-center border px-3 py-1 no-underline transition',
								currentView === 'categories'
									? 'border-zinc-900 bg-zinc-900 text-zinc-50 dark:border-zinc-200 dark:bg-zinc-200 dark:text-zinc-900'
									: 'border-zinc-300 bg-white hover:border-zinc-900 hover:text-zinc-900 dark:border-zinc-600 dark:bg-[#222] dark:hover:border-zinc-100 dark:hover:text-zinc-100',
							]}
						>
							Categories
						</a>
						<a
							href="/archive/tags/"
							class:list={[
								'inline-flex items-center border px-3 py-1 no-underline transition',
								currentView === 'tags'
									? 'border-zinc-900 bg-zinc-900 text-zinc-50 dark:border-zinc-200 dark:bg-zinc-200 dark:text-zinc-900'
									: 'border-zinc-300 bg-white hover:border-zinc-900 hover:text-zinc-900 dark:border-zinc-600 dark:bg-[#222] dark:hover:border-zinc-100 dark:hover:text-zinc-100',
							]}
						>
							Tags
						</a>
					</nav>
				</header>

				<div class="space-y-8">
					{
						tagGroups.map(([name, posts]) => (
							<section
								class="space-y-3"
								aria-labelledby={`tag-${name}`}
							>
								<h2
									id={`tag-${name}`}
									class="text-sm font-semibold text-zinc-900 dark:text-zinc-100"
								>
									#{name}
									<span class="ml-2 text-xs font-normal text-zinc-400 dark:text-zinc-400">
										{posts.length} post{posts.length === 1 ? '' : 's'}
									</span>
								</h2>
								<ul class="space-y-2 text-sm">
									{
										posts
											.sort(
												(a, b) =>
													b.data.pubDate.valueOf() -
													a.data.pubDate.valueOf(),
											)
											.map((post) => (
												<li class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
													<span class="w-24 shrink-0 text-xs text-zinc-400 dark:text-zinc-400">
														<FormattedDate date={post.data.pubDate} />
													</span>
													<a
														href={`/posts/${post.id}/`}
														class="flex-1 text-zinc-900 no-underline hover:underline dark:text-zinc-100"
													>
														{post.data.title}
													</a>
												</li>
											))
									}
								</ul>
							</section>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

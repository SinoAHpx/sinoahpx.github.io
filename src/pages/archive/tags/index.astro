---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

type Post = CollectionEntry<'blog'>;
const allPosts = await getCollection('blog');

function groupByTag(posts: Post[]) {
	const groups = new Map<string, Post[]>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) {
			const trimmed = tag.trim();
			if (!trimmed) continue;
			const list = groups.get(trimmed) ?? [];
			list.push(post);
			groups.set(trimmed, list);
		}
	}
	return Array.from(groups.entries()).sort(([a], [b]) => a.localeCompare(b, 'en'));
}

const tagGroups = groupByTag(allPosts);
const currentView: 'date' | 'categories' | 'tags' = 'tags';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`归档 -- 标签 -- ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-6 pb-16 lg:mx-0 lg:ml-20 lg:mr-56 lg:pt-24">
			<nav class="flex gap-6 text-sm text-ink-light dark:text-ink-light-dark">
				<a href="/archive/" class:list={['no-underline', currentView === 'date' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>时间</a>
				<a href="/archive/categories/" class:list={['no-underline', currentView === 'categories' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>分类</a>
				<a href="/archive/tags/" class:list={['no-underline', currentView === 'tags' ? 'text-ink dark:text-ink-dark' : 'hover:text-ink dark:hover:text-ink-dark']}>标签</a>
			</nav>

			<div class="mt-12 space-y-14">
				{tagGroups.map(([name, posts]) => (
					<section aria-labelledby={`tag-${name}`}>
						<h2 id={`tag-${name}`} class="mb-6 text-xl text-ink-light dark:text-ink-light-dark">
							#{name}
							<span class="ml-2 text-sm text-ink-faint dark:text-ink-faint-dark">{posts.length}</span>
						</h2>
						<ul class="space-y-5">
							{posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).map((post) => (
								<li>
									<a href={`/posts/${post.id}/`} class="block text-ink no-underline hover:opacity-70 dark:text-ink-dark">
										{post.data.title}
									</a>
									<span class="mt-1 block font-sans text-xs text-ink-faint dark:text-ink-faint-dark">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
